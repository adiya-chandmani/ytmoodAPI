# YouTube Data API 키 (서버 측에서만 사용, 호출자 키와 별개)
YOUTUBE_API_KEY=YOUR_API_KEY

# 관리자 엔드포인트(/users, /apikeys)용 키. 비워두면 Admin 플랜 키만 접근 가능.
ADMIN_API_KEY=CHANGE_ME

# 배포 환경(Render 등)은 단일 URL을 준다. 있으면 아래 POSTGRES_* 보다 우선한다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# DATABASE_URL이 없을 때 사용하는 로컬/도커 설정
POSTGRES_USER=ytmood
POSTGRES_PASSWORD=ytmoodpw
POSTGRES_DB=ytmood
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis는 선택. 없으면 사용량 제한 없이 동작한다.
REDIS_HOST=localhost
REDIS_PORT=6379
